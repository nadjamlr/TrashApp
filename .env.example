OLLAMA_HOST=http://host.docker.internal:11434
OLLAMA_MODEL_TEXT=llama3.2
# Vision model — pull before starting: ollama pull qwen2.5vl
OLLAMA_MODEL_VISION=qwen2.5vl

GROQ_API_KEY=

# Force all LLM calls in chat-agent (Crew, smalltalk, polish) to use Ollama
# instead of Groq. Scope: chat-agent only. Other services ignore this.
# When true, GROQ_API_KEY is ignored inside chat-agent. Default: false.
CHAT_USE_OLLAMA=false

# OpenRouteService API key for geocoding and routing.
ORS_API_KEY=

RULES_PATH=/data/munich_rules.yaml

# Mobile app service URLs — run ./update-ip.sh to generate apps/mobile/.env.local
# EXPO_PUBLIC_VISION_AGENT_URL=http://<YOUR_IP>:8001
# EXPO_PUBLIC_CHAT_AGENT_URL=http://<YOUR_IP>:8004
# EXPO_PUBLIC_INSIGHT_AGENT_URL=http://<YOUR_IP>:8003
# EXPO_PUBLIC_LOCATIONS_SERVICE_URL=http://<YOUR_IP>:8005
